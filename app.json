{
  "expo": {
    "name": "mobile-app-expo-movies",
    "slug": "mobile-app-expo-movies",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobileappexpomovies",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.mobile-app-expo-movies"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mobileappexpomovies"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/font/Satoshi-Light.otf",
              "./assets/font/Satoshi-LightItalic.otf",
              "./assets/font/Satoshi-Regular.otf",
              "./assets/font/Satoshi-Italic.otf",
              "./assets/font/Satoshi-Medium.otf",
              "./assets/font/Satoshi-MediumItalic.otf",
              "./assets/font/Satoshi-Bold.otf",
              "./assets/font/Satoshi-BoldItalic.otf",
              "./assets/font/Satoshi-Black.otf",
              "./assets/font/Satoshi-BlackItalic.otf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Satoshi",
                "fontDefinitions": [
                  { "path": "./assets/font/Satoshi-Light.otf", "weight": 300 },
                  { "path": "./assets/font/Satoshi-LightItalic.otf", "weight": 300, "style": "italic" },
                  { "path": "./assets/font/Satoshi-Regular.otf", "weight": 400 },
                  { "path": "./assets/font/Satoshi-Italic.otf", "weight": 400, "style": "italic" },
                  { "path": "./assets/font/Satoshi-Medium.otf", "weight": 500 },
                  { "path": "./assets/font/Satoshi-MediumItalic.otf", "weight": 500, "style": "italic" },
                  { "path": "./assets/font/Satoshi-Bold.otf", "weight": 700 },
                  { "path": "./assets/font/Satoshi-BoldItalic.otf", "weight": 700, "style": "italic" },
                  { "path": "./assets/font/Satoshi-Black.otf", "weight": 900 },
                  { "path": "./assets/font/Satoshi-BlackItalic.otf", "weight": 900, "style": "italic" }
                ]
              }
            ]
          }
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
